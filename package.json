{
  "name": "laxmi-niwas-platform",
  "version": "1.0.0",
  "description": "Laxmi Niwas Verification Platform - Enterprise FinTech Verification Suite",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "server": "node server/src/index.js",
    "client": "npm --prefix client run dev"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "fintech",
    "verification",
    "pan",
    "aadhaar",
    "digilocker",
    "cibil",
    "kyc",
    "react",
    "express"
  ],
  "author": "Laxmi Niwas",
  "license": "ISC"
}
